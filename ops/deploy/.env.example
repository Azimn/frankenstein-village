# Example nonsecret environment for an invited, TLS-proxied alpha.
# Source using your service manager's EnvironmentFile, or export variables.
# Do not put passwords in this file. Never commit real credentials.
FV_DEPLOYMENT_MODE=public
FV_PUBLIC_HOST=village.example.org
FV_PUBLIC_REGISTRATION=0
# Evennia uses this EXTERNAL WSS proxy port to build the browser URL.
WEBCLIENT_CLIENT_PROXY_PORT=4042
