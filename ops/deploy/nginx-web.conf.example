# Example Nginx HTTPS/WSS frontend for Frankenstein Village.
# Replace village.example.org and the certificate paths before deployment.
# Include this file under the http context (sites-available / sites-enabled).
# Evennia must run with FV_DEPLOYMENT_MODE=public and FV_PUBLIC_HOST set.
#
# Firewall: allow inbound 80/443. Do not expose 4000/4001/4002/4005/4006.

server {
    listen 80;
    listen [::]:80;
    server_name village.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name village.example.org;

    ssl_certificate /etc/letsencrypt/live/village.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/village.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    # A dedicated location is required for the browser's secure socket.
    # Keep the websocket upgrade and long-lived reads intact for AI sessions.
    location /ws {
        proxy_pass http://127.0.0.1:4002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
